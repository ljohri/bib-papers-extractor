# Polite-pool email used by Unpaywall (required for the public Unpaywall API).
UNPAYWALL_EMAIL=your-email@example.com

# Optional Semantic Scholar API key for higher rate limits.
SEMANTIC_SCHOLAR_API_KEY=

# Polite-pool mailto used by Crossref. Recommended.
CROSSREF_MAILTO=your-email@example.com

# Local SQLite cache for API responses. Path is created if missing.
CACHE_DB_PATH=./cache/bibpdf.sqlite

# Default input directory (created on startup).
DEFAULT_INPUT_DIR=./data/input

# Default output directory for runs when MCP tools omit output_dir.
DEFAULT_OUTPUT_DIR=./data/output

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Max concurrent network requests across all resolvers/locator.
MAX_CONCURRENT_REQUESTS=5

# Confidence threshold below which references are NOT auto-downloaded.
AUTO_DOWNLOAD_CONFIDENCE_THRESHOLD=0.80

# A2A (Agent2Agent) HTTP server — `uv run bibpdf-a2a`
A2A_HOST=127.0.0.1
A2A_PORT=8080
A2A_PUBLIC_URL=http://127.0.0.1:8080
